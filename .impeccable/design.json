  "narrative": {
    "northStar": "The Commissioning Workspace",
    "overview": "This document records the implemented GitHub Pages installer in `docs/index.html` and `docs/installer.css`. It does not define the firmware interface in `web/`. The design was derived from the implementation; the descriptive language here is documentation, not a record of explicit user style approval.\n\nPurpose and progress occupy the left column. One active task occupies the white workspace on the right, beneath persistent USB connection status. Clear labels, restrained teal, and flat surfaces keep attention on the next action. There is no ambient motion or decorative imagery.",
    "keyCharacteristics": [
      "Four real setup steps, with supporting panels inside the current step.",
      "Teal actions and white surfaces against a pale ice background.",
      "Local system typography and visible keyboard focus.",
      "Release metadata inside the installation task."
    ],
    "rules": [
      {
        "name": "The State Rule",
        "body": "Use text and native control state alongside color to communicate selection, connection and errors.",
        "section": "colors"
      },
      {
        "name": "The Heading Rule",
        "body": "Keep the display heading's measured tracking; avoid tightening it further or adding an eyebrow above it.",
        "section": "typography"
      },
      {
        "name": "The Task Rule",
        "body": "Keep USB status above the active task and release metadata within installation.",
        "section": "layout"
      },
      {
        "name": "The Focus Rule",
        "body": "Preserve the teal keyboard outline (3px with 4px offset), the skip link and focusable task headings.",
        "section": "components"
      }
    ],
    "dos": [
      "Do keep one active task inside the persistent USB workspace.",
      "Do place destructive consequences beside the action and its acknowledgement.",
      "Do preserve native controls, visible labels and keyboard focus.",
      "Do keep release details inside installation and technical downloads below setup."
    ],
    "donts": [
      "Don't apply this installer specification to the firmware interface without a separate design decision.",
      "Don't add ambient motion, decorative imagery or a workspace shadow.",
      "Don't replace the four real steps with decorative progress.",
      "Don't hide errors or use color alone to communicate state."
    ]
  }
